APP_HOST=0.0.0.0
APP_PORT=8081

DATA_DIR=/data
MANAGER_DB_PATH=/data/manager.db
MANAGER_ENV_FILE=/app/.env
HF_HOME=/data/hf-cache
HF_HUB_CACHE=/data/hf-cache/hub

# Defaults for the built-in local target rig. For SSH target rigs, configure
# Settings -> Target Rigs in the UI so downloads/config/GPU/restart run remotely.
MANAGER_MODEL_ROOT=/models
LLAMA_SWAP_MODEL_ROOT=/models
LLAMA_SWAP_CONFIG_PATH=/app/config.yaml
BACKUPS_DIR=/backups
DOWNLOAD_TEMP_DIR=/data/tmp

MAX_PARALLEL_DOWNLOADS=1
MAX_UPLOAD_BYTES=53687091200
ALLOWED_UPLOAD_EXTENSIONS=.gguf,.safetensors,.json,.jinja,.jinja2,.model,.tiktoken
DISK_SAFETY_GB=20
LLAMA_SERVER_CMD=/app/llama-server

# Optional local llama-swap restart controls.
# For SSH rigs, use the target rig restart command instead.
# Local mode requires mounting /var/run/docker.sock into the manager container.
LLAMA_SWAP_RESTART_ENABLED=false
LLAMA_SWAP_CONTAINER_NAME=llama-swap
DOCKER_SOCKET_PATH=/var/run/docker.sock
LLAMA_SWAP_RESTART_TIMEOUT=30
# Compose-only value if you enable the Docker socket mount with non-root runtime:
# Linux: DOCKER_SOCKET_GID=$(stat -c '%g' /var/run/docker.sock)
DOCKER_SOCKET_GID=

# Leave empty for same-origin Docker/LAN use. For Vite dev, use:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# Optional Hugging Face token for gated/private model downloads.
# Leave blank here and put the real value in your local .env only.
HF_TOKEN=
