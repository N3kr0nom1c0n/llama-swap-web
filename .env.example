APP_HOST=0.0.0.0
APP_PORT=8081

DATA_DIR=/data
MANAGER_DB_PATH=/data/manager.db
MANAGER_ENV_FILE=/app/.env

MANAGER_MODEL_ROOT=/models
LLAMA_SWAP_MODEL_ROOT=/models
LLAMA_SWAP_CONFIG_PATH=/app/config.yaml
BACKUPS_DIR=/backups
DOWNLOAD_TEMP_DIR=/tmp

MAX_PARALLEL_DOWNLOADS=1
DISK_SAFETY_GB=20
LLAMA_SERVER_CMD=/app/llama-server

# Optional Hugging Face token for gated/private model downloads.
# Leave blank here and put the real value in your local .env only.
HF_TOKEN=
